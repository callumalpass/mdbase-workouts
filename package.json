{
  "name": "mdbase-workouts",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "npm run manifest && concurrently -n fe,be -c cyan,magenta \"vite --host\" \"tsx watch server/index.ts\"",
    "dev:fe": "npm run manifest && vite --host",
    "dev:be": "tsx watch server/index.ts",
    "build": "npm run manifest && vite build",
    "typecheck": "tsc -p tsconfig.json && tsc -p tsconfig.server.json",
    "lint": "npm run typecheck",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:connect": "playwright test --config playwright.dogfood.config.ts",
    "manifest": "node scripts/write-manifest.mjs",
    "screenshots": "playwright test tests/mobile-screenshots.spec.ts --project=mobile",
    "seed": "tsx scripts/seed-exercises.ts",
    "start": "NODE_ENV=production tsx server/index.ts"
  },
  "dependencies": {
    "@callumalpass/mdbase": "0.3.0-rc.1",
    "@mdbase/connect": "file:vendor/mdbase-connect-0.1.0-beta.1.tgz",
    "@mdbase/connect-protocol": "file:vendor/mdbase-connect-protocol-0.1.0-beta.1.tgz",
    "@hono/node-server": "^1.19.14",
    "hono": "^4.12.30",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.58.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^25.2.2",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.0",
    "autoprefixer": "^10.4.20",
    "concurrently": "^9.0.0",
    "jsdom": "^28.0.0",
    "postcss": "^8.4.47",
    "tailwindcss": "^3.4.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "vite": "^6.4.3",
    "vite-plugin-pwa": "^1.2.0",
    "vitest": "^4.0.18"
  },
  "overrides": {
    "tsx": {
      "esbuild": "0.28.1"
    }
  }
}
